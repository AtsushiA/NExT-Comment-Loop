{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "next/comment-author",
  "version": "1.1.1",
  "title": "Comment Author",
  "category": "theme",
  "description": "コメント投稿者のハンドル名を表示するブロックです。",
  "textdomain": "next-comment-loop",
  "parent": [ "next/comment-loop" ],
  "usesContext": [ "next/commentId" ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontWeight": true,
      "fontStyle": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "next-comment-loop-editor",
  "render": "file:./render.php"
}
