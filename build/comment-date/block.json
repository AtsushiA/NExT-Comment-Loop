{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "next/comment-date",
  "version": "1.1.3",
  "title": "Comment Date",
  "category": "theme",
  "description": "コメントの投稿日時を表示するブロックです。",
  "textdomain": "next-comment-loop",
  "ancestor": [
    "next/comment-loop"
  ],
  "attributes": {
    "format": {
      "type": "string",
      "default": "Y/m/d H:i"
    }
  },
  "usesContext": [
    "next/commentId"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontWeight": true,
      "fontStyle": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "next-comment-loop-editor",
  "render": "file:./render.php"
}